{
  "expo": {
    "name": "FitTrack",
    "slug": "fittrack",
    "version": "1.0.0",
    "description": "Kalori takibi, antrenman programları, su takibi, AI koçluk ve vücut ölçümleri ile kişisel sağlık ve fitness asistanınız.",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "fittrack",
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#4CAF50",
      "resizeMode": "contain"
    },
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fittrack.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Barkod taramak ve yemek fotoğrafı çekmek için kamera izni gereklidir.",
        "NSPhotoLibraryUsageDescription": "Yemek fotoğrafı seçmek için galeri izni gereklidir.",
        "NSHealthShareUsageDescription": "Sağlık verilerinizi görüntülemek için izin gereklidir.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4CAF50"
      },
      "package": "com.fittrack.app",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "VIBRATE",
        "NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-camera",
      "expo-notifications",
      "expo-secure-store",
      "expo-sqlite",
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "apiBaseUrl": "https://fittrack-api.vercel.app",
      "eas": {
        "projectId": ""
      }
    }
  }
}
