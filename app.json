{
  "expo": {
    "name": "FitTrack - AI Fitness Koç",
    "slug": "fittrack",
    "version": "1.0.0",
    "description": "Yapay zeka destekli kişisel fitness koçunuz. Barkodlu kalori sayacı, AI antrenman planları, su takibi, vücut ölçümleri ve sağlık entegrasyonu. HealthKit & Health Connect desteği ile tüm sağlık verileriniz tek uygulamada. 12 dilde kullanılabilir.",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "fittrack",
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#4CAF50",
      "resizeMode": "contain"
    },
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4CAF50"
      },
      "package": "com.okanu.fittrack",
      "versionCode": 2,
      "permissions": [
        "CAMERA",
        "VIBRATE",
        "NOTIFICATIONS",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-camera",
      "expo-notifications",
      "expo-secure-store",
      "expo-sqlite",
      "expo-asset",
      "expo-font",
      [
        "expo-health-connect",
        {
          "requestPermissionsOnStart": false
        }
      ],
      "./plugins/withIAPAndroid",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3850996093825148~5620803043",
          "iosAppId": "ca-app-pub-3850996093825148~5620803043"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://fittrack-a958c.web.app",
      "eas": {
        "projectId": "ab8d70ce-dbaa-4638-8aa9-dd8781d83e53"
      }
    }
  }
}
