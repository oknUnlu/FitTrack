{
  "expo": {
    "name": "FitTrack - AI Fitness Koç",
    "slug": "fittrack",
    "version": "1.0.0",
    "description": "Yapay zeka destekli kişisel fitness koçunuz. Barkodlu kalori sayacı, AI antrenman planları, su takibi, vücut ölçümleri ve sağlık entegrasyonu. HealthKit & Health Connect desteği ile tüm sağlık verileriniz tek uygulamada. 12 dilde kullanılabilir.",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "fittrack",
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#4CAF50",
      "resizeMode": "contain"
    },
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fittrack.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Barkod taramak ve yemek fotoğrafı çekmek için kamera izni gereklidir.",
        "NSPhotoLibraryUsageDescription": "Yemek fotoğrafı seçmek için galeri izni gereklidir.",
        "NSHealthShareUsageDescription": "Sağlık verilerinizi görüntülemek için izin gereklidir.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4CAF50"
      },
      "package": "com.fittrack.app",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "VIBRATE",
        "NOTIFICATIONS",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-camera",
      "expo-notifications",
      "expo-secure-store",
      "expo-sqlite",
      "expo-asset",
      "expo-font",
      ["react-native-health", {
        "isClinicalDataEnabled": false
      }],
      ["expo-health-connect", {
        "requestPermissionsOnStart": false
      }],
      ["expo-build-properties", {
        "android": {
          "compileSdkVersion": 35,
          "targetSdkVersion": 35,
          "minSdkVersion": 26
        }
      }]
    ],
    "extra": {
      "apiBaseUrl": "https://fittrack-api-liard.vercel.app",
      "eas": {
        "projectId": ""
      }
    }
  }
}
