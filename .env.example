# FitTrack Environment Variables
# Copy this file to .env and fill in the values

# Gemini AI API Key (optional - can also be set in-app via Profile screen)
# Get your key from: https://aistudio.google.com/apikey
EXPO_PUBLIC_GEMINI_API_KEY=

# Environment: development | staging | production
EXPO_PUBLIC_APP_ENV=development

# --- Vercel Backend Environment Variables ---
# (Set these in Vercel Dashboard > Settings > Environment Variables)

# Upstash Redis (auto-provisioned via Vercel Marketplace integration)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Google Play package name
# GOOGLE_PLAY_PACKAGE_NAME=com.okanu.fittrack

# Google Service Account Key (JSON stringified) for Play purchase verification
# Get from: Google Cloud Console → IAM → Service Accounts → Create Key → JSON
# GOOGLE_SERVICE_ACCOUNT_KEY=

# Monthly Gemini API call budget (default: 10000)
# MONTHLY_BUDGET_LIMIT=10000

# Admin API key for /api/usage monitoring endpoint
# ADMIN_API_KEY=
