# FitTrack Environment Variables
# Bu dosya yalnızca dokümantasyon amaçlıdır.
# İstemci (React Native / Expo) tarafı HİÇBİR gizli anahtar barındırmaz —
# AI çağrıları Firebase Cloud Functions üzerinden proxy'lenir.

# Environment: development | staging | production
EXPO_PUBLIC_APP_ENV=development

# ---------------------------------------------------------------------
# Backend (Firebase Cloud Functions) — Firebase Secrets ile yönetilir
#   firebase functions:secrets:set <SECRET_NAME>
# Bu değerler client tarafına ASLA konulmaz.
# ---------------------------------------------------------------------

# Gemini AI API Key (Google AI Studio: https://aistudio.google.com/apikey)
# GEMINI_API_KEY=

# Aylık Gemini API çağrı bütçesi (default: 10000)
# MONTHLY_BUDGET_LIMIT=10000

# Google Play paket adı
# GOOGLE_PLAY_PACKAGE_NAME=com.okanu.fittrack

# Google Service Account Key (JSON stringified) — Play satın alma doğrulaması
# Cloud Console → IAM → Service Accounts → Create Key → JSON
# GOOGLE_SERVICE_ACCOUNT_KEY=

# Upstash Redis (rate limit + premium cache)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# /api/usage izleme endpoint'i için admin anahtarı
# ADMIN_API_KEY=
