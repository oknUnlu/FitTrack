rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Verified products: public read, no direct client writes
    match /verified_products/{barcode} {
      allow read: if true;
      allow write: if false;
    }

    // Barcode submissions: validated create only, no read/update/delete
    match /barcode_submissions/{docId} {
      allow read: if false;
      allow create: if request.resource.data.deviceId is string
                    && request.resource.data.barcode is string
                    && request.resource.data.name is string
                    && request.resource.data.calories is number
                    && request.resource.data.calories >= 0
                    && request.resource.data.calories <= 5000
                    && request.resource.data.protein is number
                    && request.resource.data.protein >= 0
                    && request.resource.data.carbs is number
                    && request.resource.data.carbs >= 0
                    && request.resource.data.fat is number
                    && request.resource.data.fat >= 0;
      allow update, delete: if false;
    }

    // Server-side collections: only accessible via Firebase Admin SDK (Cloud Functions)
    // Clients cannot read or write these directly
    match /rate_limits/{doc} {
      allow read, write: if false;
    }
    match /premium_status/{doc} {
      allow read, write: if false;
    }
    match /promo_premium/{doc} {
      allow read, write: if false;
    }
    match /promo_usage/{doc} {
      allow read, write: if false;
    }
    match /usage_stats/{doc} {
      allow read, write: if false;
    }

    // Default: deny all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
